# Copy this file to .env for local runs and fill in your own values.
# .env is git-ignored. In GitHub Actions these come from repository secrets.
#
# Never commit real credentials.

# Google AI Studio -> Get API key (free tier)
GEMINI_API_KEY=

# Optional: https://www.pexels.com/api/ -> free API key.
# If omitted, Wikimedia Commons is used without an API key.
PEXELS_API_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Printed by: python get_refresh_token.py --client-secrets client_secret.json
YT_REFRESH_TOKEN=
